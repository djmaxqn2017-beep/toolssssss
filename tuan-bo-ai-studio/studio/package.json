{
  "name": "tuan-bo-ai-studio",
  "version": "0.2.0",
  "description": "Tuấn Bồ AI Studio - offline AI portrait editor",
  "main": "src/main.js",
  "author": "Tuan Bo",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.tuanbo.aistudio",
    "productName": "Tuấn Bồ AI Studio",
    "artifactName": "TuanBo-AI-Studio-${version}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuấn Bồ AI Studio",
      "uninstallDisplayName": "Tuấn Bồ AI Studio"
    }
  }
}
